{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myresearcher.encoder-m2-s1-owner-authorization-receipt.v2",
  "title": "MyResearcher M2-S1 tracked owner authorization receipt",
  "description": "Only the fixed tracked receipt path is eligible. Its hash is necessary but never sufficient: the independent owner-decision record must allowlist it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_schema_version", "authorization_granted", "owner_decision_id", "expires_at_utc", "frozen_contract_commit", "contract_sha256", "stage_id", "unified_repository", "canonical_config_sha256", "model", "cache_snapshot_content_address", "runtime_environment_sha256", "cache_policy", "execution", "output_dir", "receipt_content_address"],
  "properties": {
    "receipt_schema_version": {"const": "myresearcher.encoder-m2-s1-owner-authorization-receipt.v2"},
    "authorization_granted": {"type": "boolean"},
    "owner_decision_id": {"type": "string", "minLength": 1},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "frozen_contract_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage_id": {"const": "M2-S1-FROZEN-SHARED-SEVEN-HEAD-CONTROL"},
    "unified_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit", "remote_branch"],
      "properties": {
        "branch": {"const": "feat/m2-s1-runner"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "remote_branch": {"const": "origin/feat/m2-s1-runner"}
      }
    },
    "canonical_config_sha256": {"const": "92436eff13c4c67a6dec8a3d645c4e40a4ce8c927d6cb522720709d980cff617"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "revision", "license", "model_weight_sha256", "tokenizer_json_sha256", "vocab_txt_sha256"],
      "properties": {
        "model_id": {"const": "hfl/rbt3"},
        "revision": {"const": "0aa0527ff4170f29e1dfd3eb6ef60dc67e1bf75c"},
        "license": {"const": "Apache-2.0"},
        "model_weight_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tokenizer_json_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "vocab_txt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "cache_snapshot_content_address": {"const": "33e1efd86cff8ed0d4039932fc25880fd89f9382347a0359e6c7a70648504b96"},
    "runtime_environment_sha256": {"const": "13d11501fe5b43d97500909728ac1ed6e6118398b15c95ff9496f565e598c6c6"},
    "cache_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_files_only", "no_download"],
      "properties": {"local_files_only": {"const": true}, "no_download": {"const": true}}
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seeds", "train_rows", "dev_rows", "train_role", "dev_role", "device_policy", "per_run_wall_time_minutes", "total_new_local_disk_gib", "prohibitions"],
      "properties": {
        "seeds": {"const": [35, 71, 107]},
        "train_rows": {"const": 1822},
        "dev_rows": {"const": 448},
        "train_role": {"const": "TRAIN_ONLY_FIT"},
        "dev_role": {"const": "EARLY_STOPPING_AND_DIAGNOSTIC_ONLY"},
        "device_policy": {"const": "MPS_FIRST_CPU_FALLBACK"},
        "per_run_wall_time_minutes": {"const": 120},
        "total_new_local_disk_gib": {"const": 10},
        "prohibitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["test", "anchor", "gold", "ood", "llm", "cloud_or_external_api", "production", "model_download", "dependency_install", "full_unfreeze", "s2_or_s3"],
          "properties": {
            "test": {"const": false}, "anchor": {"const": false}, "gold": {"const": false}, "ood": {"const": false}, "llm": {"const": false}, "cloud_or_external_api": {"const": false}, "production": {"const": false}, "model_download": {"const": false}, "dependency_install": {"const": false}, "full_unfreeze": {"const": false}, "s2_or_s3": {"const": false}
          }
        }
      }
    },
    "output_dir": {"type": "string", "minLength": 1},
    "receipt_content_address": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
