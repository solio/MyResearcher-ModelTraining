{
  "artifact_schema_version": "myresearcher.semantic-label-schema.v0.3",
  "schema_version": "semantic-schema-candidate-v0.3",
  "status": "CANDIDATE",
  "base_schema_version": "semantic-schema-calibrated-v0.2.1",
  "v1_prediction_heads": {
    "target_mode": {
      "task_type": "single_label",
      "class_order": ["ON_TARGET", "CROSS_TARGET", "MARKET_GENERAL", "UNKNOWN"]
    },
    "stance": {
      "task_type": "single_label",
      "class_order": ["BULL", "BEAR", "NEUTRAL", "MIXED", "UNKNOWN"]
    },
    "emotion_primary": {
      "task_type": "single_label",
      "class_order": ["FEAR", "ANXIETY", "ANGER", "FRUSTRATION", "REGRET", "HOPE", "EXCITEMENT", "FOMO", "CALM", "NONE_EXPLICIT", "UNKNOWN"]
    },
    "emotion_target": {
      "task_type": "single_label",
      "class_order": ["PRICE", "POSITION", "COMPANY", "MARKET", "OTHER", "NOT_APPLICABLE", "UNKNOWN"]
    },
    "action_tendency": {
      "task_type": "single_label",
      "class_order": ["BUY", "ADD", "HOLD", "DO_T", "REDUCE", "SELL", "WATCH", "NO_ACTION_SIGNAL", "UNKNOWN"]
    },
    "reasoning_tags": {
      "task_type": "multi_label",
      "class_order": ["FUNDAMENTAL", "VALUATION", "TECHNICAL_PRICE", "FLOW_POSITIONING", "NEWS_EVENT", "RUMOR", "SOCIAL_PROOF", "MACRO_POLICY", "THEME_NARRATIVE", "NO_REASON_GIVEN", "RELATIVE_PERFORMANCE", "CROSS_STOCK_REFERENCE", "SARCASM_IRONY", "WORDPLAY", "UNKNOWN"]
    },
    "context_dependency": {
      "task_type": "single_label",
      "class_order": ["SELF_CONTAINED", "PARTIAL_CONTEXT", "EXTERNAL_CONTEXT_REQUIRED", "UNKNOWN"]
    }
  },
  "auxiliary_factors": {
    "expectation_phase": {
      "task_type": "single_label",
      "class_order": ["ANTICIPATED", "ONGOING_OR_REALIZED", "UNKNOWN"],
      "optional": true,
      "name_zh": "预期时态",
      "definition": "表达文本中的预期是尚未发生还是已经发生/正在发生",
      "select_when": "文本有可判断的结果或事件时态线索",
      "not_select_when": "没有时态线索或该因子不适用",
      "confusable_with": ["arousal_level", "desired_price_direction"],
      "examples": ["明天涨停板", "今天涨停了"],
      "logical_owner_head": "emotion_primary",
      "applicable_when": "文本表达情绪或对结果的期待",
      "label_metadata": {
        "ANTICIPATED": {
          "name_zh": "预期中",
          "definition": "结果或事件尚未发生，文本在期待其发生",
          "select_when": "出现将要、希望、预期或未来结果线索",
          "not_select_when": "结果已经发生或仅陈述当前事实",
          "confusable_with": ["ONGOING_OR_REALIZED"],
          "examples": ["明天涨停板"],
          "logical_owner_head": "emotion_primary",
          "applicable_when": "存在未来结果期待"
        },
        "ONGOING_OR_REALIZED": {
          "name_zh": "进行中或已实现",
          "definition": "事件正在进行或结果已经发生",
          "select_when": "出现正在、已经、今天涨停等完成线索",
          "not_select_when": "只有未来假设或愿望",
          "confusable_with": ["ANTICIPATED"],
          "examples": ["今天涨停了"],
          "logical_owner_head": "emotion_primary",
          "applicable_when": "存在当前或已发生事件"
        },
        "UNKNOWN": {
          "name_zh": "无法判断",
          "definition": "文本存在时态问题但无法确定",
          "select_when": "有相关表达但时态不可判定",
          "not_select_when": "因子缺失或不适用",
          "confusable_with": ["缺失"],
          "examples": ["可能会涨"],
          "logical_owner_head": "emotion_primary",
          "applicable_when": "时态问题存在但证据不足"
        }
      },
      "missing_semantics": "unannotated_or_not_applicable",
      "unknown_semantics": "factor_present_but_not_determinable",
      "missing_loss_mask": 0,
      "unknown_loss_mask": 1
    },
    "arousal_level": {
      "task_type": "ordered_single_label",
      "class_order": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"],
      "optional": true,
      "name_zh": "情绪唤醒强度",
      "definition": "表达情绪或叙事的相对唤醒强度",
      "select_when": "文本有可判断的情绪强弱线索",
      "not_select_when": "没有情绪强度线索或该因子不适用",
      "confusable_with": ["emotion_primary", "expectation_phase"],
      "examples": ["随便吧", "坐等起飞"],
      "logical_owner_head": "emotion_primary",
      "applicable_when": "emotion_primary 不是 NONE_EXPLICIT 且文本有强度线索",
      "ordered_values": ["LOW", "MEDIUM", "HIGH"],
      "label_metadata": {
        "LOW": {
          "name_zh": "低",
          "definition": "平静、弱表达或低唤醒情绪",
          "select_when": "语气平缓且缺少强烈情绪词",
          "not_select_when": "有明显激动或紧张表达",
          "confusable_with": ["MEDIUM"],
          "examples": ["随便吧"],
          "logical_owner_head": "emotion_primary",
          "applicable_when": "存在可判断的低唤醒语气"
        },
        "MEDIUM": {
          "name_zh": "中",
          "definition": "有情绪但强度居中的表达",
          "select_when": "情绪明显但未达到强烈动员或惊惧",
          "not_select_when": "几乎无情绪或高度激动",
          "confusable_with": ["LOW", "HIGH"],
          "examples": ["有点担心"],
          "logical_owner_head": "emotion_primary",
          "applicable_when": "存在中等唤醒线索"
        },
        "HIGH": {
          "name_zh": "高",
          "definition": "激动、恐慌、愤怒或强烈动员表达",
          "select_when": "有强烈情绪、感叹或紧迫行动语气",
          "not_select_when": "语气平缓或仅陈述事实",
          "confusable_with": ["MEDIUM"],
          "examples": ["坐等起飞"],
          "logical_owner_head": "emotion_primary",
          "applicable_when": "存在高唤醒线索"
        },
        "UNKNOWN": {
          "name_zh": "无法判断",
          "definition": "存在强度问题但无法确定等级",
          "select_when": "有情绪线索但强度不可辨",
          "not_select_when": "因子缺失或不适用",
          "confusable_with": ["缺失"],
          "examples": ["这是什么意思"],
          "logical_owner_head": "emotion_primary",
          "applicable_when": "强度问题存在但证据不足"
        }
      },
      "missing_semantics": "unannotated_or_not_applicable",
      "unknown_semantics": "factor_present_but_not_determinable",
      "missing_loss_mask": 0,
      "unknown_loss_mask": 1
    },
    "desired_price_direction": {
      "task_type": "single_label",
      "class_order": ["UP", "DOWN", "RANGE_OR_STABLE", "NON_DIRECTIONAL", "UNKNOWN"],
      "optional": true,
      "name_zh": "期望价格方向",
      "definition": "表达文本期待的价格结果方向，而不是作者是否交易",
      "select_when": "文本有价格方向或稳定区间线索",
      "not_select_when": "只有作者动作、情绪或无方向陈述",
      "confusable_with": ["stance", "action_tendency"],
      "examples": ["明天涨停板", "十二块钱是铁底"],
      "logical_owner_head": "emotion_primary",
      "applicable_when": "文本表达对价格结果的期待",
      "label_metadata": {
        "UP": {
          "name_zh": "上涨",
          "definition": "期待价格向上",
          "select_when": "明确预测上涨或更高价格",
          "not_select_when": "只说买入而没有价格方向",
          "confusable_with": ["RANGE_OR_STABLE"],
          "examples": ["明天涨停板"],
          "logical_owner_head": "emotion_primary",
          "applicable_when": "存在明确向上结果"
        },
        "DOWN": {
          "name_zh": "下跌",
          "definition": "期待价格向下",
          "select_when": "明确预测下跌或更低价格",
          "not_select_when": "下跌只是买入条件且最终目标不明",
          "confusable_with": ["NON_DIRECTIONAL"],
          "examples": ["还要继续跌"],
          "logical_owner_head": "emotion_primary",
          "applicable_when": "存在明确向下结果"
        },
        "RANGE_OR_STABLE": {
          "name_zh": "区间或稳定",
          "definition": "期待横盘、震荡或稳定价格",
          "select_when": "出现震荡、横盘、区间或不变线索",
          "not_select_when": "明确单向上涨或下跌",
          "confusable_with": ["NON_DIRECTIONAL"],
          "examples": ["横盘震荡"],
          "logical_owner_head": "emotion_primary",
          "applicable_when": "存在稳定/区间结果"
        },
        "NON_DIRECTIONAL": {
          "name_zh": "非方向性",
          "definition": "文本不表达价格方向",
          "select_when": "只有情绪、事实或动作而无结果方向",
          "not_select_when": "出现可判定的价格方向",
          "confusable_with": ["RANGE_OR_STABLE"],
          "examples": ["继续持有"],
          "logical_owner_head": "emotion_primary",
          "applicable_when": "价格方向不适用"
        },
        "UNKNOWN": {
          "name_zh": "无法判断",
          "definition": "存在方向问题但方向不可确定",
          "select_when": "暗示方向但证据不足",
          "not_select_when": "因子缺失或不适用",
          "confusable_with": ["缺失"],
          "examples": ["可能有变化"],
          "logical_owner_head": "emotion_primary",
          "applicable_when": "方向问题存在但证据不足"
        }
      },
      "missing_semantics": "unannotated_or_not_applicable",
      "unknown_semantics": "factor_present_but_not_determinable",
      "missing_loss_mask": 0,
      "unknown_loss_mask": 1
    },
    "market_scope": {
      "task_type": "multi_label",
      "class_order": ["TRADING_FLOW", "INDUSTRY_PRODUCT_REGION", "BROAD_MARKET", "UNKNOWN"],
      "optional": true,
      "allow_multiple": true,
      "name_zh": "市场范围",
      "definition": "在 emotion_target=MARKET 时补充具体市场语境，可多选",
      "select_when": "emotion_target 为 MARKET 且文本有范围线索",
      "not_select_when": "emotion_target 不是 MARKET 或无范围线索",
      "confusable_with": ["emotion_target"],
      "examples": ["做T的机会来了", "光伏行业产能不会出清"],
      "logical_owner_head": "emotion_target",
      "applicable_when": "emotion_target=MARKET",
      "label_metadata": {
        "TRADING_FLOW": {
          "name_zh": "交易流",
          "definition": "主力、散户、资金或交易行为环境",
          "select_when": "出现资金、筹码、参与者或盘面行为",
          "not_select_when": "仅行业或大盘叙述",
          "confusable_with": ["BROAD_MARKET"],
          "examples": ["做T的机会来了"],
          "logical_owner_head": "emotion_target",
          "applicable_when": "市场对象是交易参与和资金流"
        },
        "INDUSTRY_PRODUCT_REGION": {
          "name_zh": "行业/产品/地区",
          "definition": "行业、产品、地区或政策市场环境",
          "select_when": "出现行业供需、产品价格、地区或政策市场",
          "not_select_when": "只有交易参与者或大盘状态",
          "confusable_with": ["BROAD_MARKET"],
          "examples": ["光伏行业产能不会出清"],
          "logical_owner_head": "emotion_target",
          "applicable_when": "市场对象是行业产品或地区"
        },
        "BROAD_MARKET": {
          "name_zh": "大盘",
          "definition": "整个市场或广泛市场状态",
          "select_when": "出现大盘、指数或整体市场状态",
          "not_select_when": "只讨论单一行业或交易流",
          "confusable_with": ["INDUSTRY_PRODUCT_REGION"],
          "examples": ["走了大盘要跳水"],
          "logical_owner_head": "emotion_target",
          "applicable_when": "市场对象是广泛大盘"
        },
        "UNKNOWN": {
          "name_zh": "无法判断",
          "definition": "市场范围存在但无法确定",
          "select_when": "确有市场语境但范围不可辨",
          "not_select_when": "因子缺失或 emotion_target 不是 MARKET",
          "confusable_with": ["缺失"],
          "examples": ["市场会怎样"],
          "logical_owner_head": "emotion_target",
          "applicable_when": "市场范围问题存在但证据不足"
        }
      },
      "missing_semantics": "unannotated_or_not_applicable",
      "unknown_semantics": "factor_present_but_not_determinable",
      "missing_loss_mask": 0,
      "unknown_loss_mask": 1,
      "unknown_is_exclusive": true
    },
    "discourse_focus": {
      "task_type": "multi_label",
      "class_order": ["ASSET_OR_COMPANY", "AUTHOR_VIEWPOINT", "AUTHOR_ACTION_OR_POSITION", "OTHER_PERSON_OR_AUDIENCE", "CLAIM_OR_NARRATIVE", "MARKET_OR_INDUSTRY", "UNKNOWN"],
      "optional": true,
      "allow_multiple": true,
      "name_zh": "话语焦点",
      "definition": "表达文本同时指向资产、作者、他人、叙事或市场的焦点，可多选",
      "select_when": "文本存在可辨识的话语对象或角色焦点",
      "not_select_when": "无焦点线索或该因子不适用",
      "confusable_with": ["target_mode"],
      "examples": ["看别人吃肉，我重仓绿毛龟", "冲高卖"],
      "logical_owner_head": "target_mode",
      "applicable_when": "需要补充 target_mode 未表达的焦点",
      "label_metadata": {
        "ASSET_OR_COMPANY": {
          "name_zh": "资产或公司",
          "definition": "焦点是标的资产或公司本身",
          "select_when": "主要围绕公司、股票或资产事实",
          "not_select_when": "焦点只在作者或他人",
          "confusable_with": ["MARKET_OR_INDUSTRY"],
          "examples": ["订单增长"],
          "logical_owner_head": "target_mode",
          "applicable_when": "资产本身是话语焦点"
        },
        "AUTHOR_VIEWPOINT": {
          "name_zh": "作者观点",
          "definition": "作者的判断、态度或观点表达",
          "select_when": "出现我认为、看好、觉得等主观判断",
          "not_select_when": "只有客观叙述或他人观点",
          "confusable_with": ["AUTHOR_ACTION_OR_POSITION"],
          "examples": ["我看好"],
          "logical_owner_head": "target_mode",
          "applicable_when": "作者观点是独立焦点"
        },
        "AUTHOR_ACTION_OR_POSITION": {
          "name_zh": "作者动作或持仓",
          "definition": "作者的交易动作、持仓或配置行为",
          "select_when": "出现买卖、加仓、清仓或持有行为",
          "not_select_when": "只表达观点而无作者动作",
          "confusable_with": ["AUTHOR_VIEWPOINT"],
          "examples": ["冲高卖"],
          "logical_owner_head": "target_mode",
          "applicable_when": "作者动作/持仓是独立焦点"
        },
        "OTHER_PERSON_OR_AUDIENCE": {
          "name_zh": "他人或受众",
          "definition": "焦点是其他人、股东、读者或受众",
          "select_when": "直接谈兄弟们、股东、别人等",
          "not_select_when": "焦点是作者自己",
          "confusable_with": ["CLAIM_OR_NARRATIVE"],
          "examples": ["看看你们亏了多少"],
          "logical_owner_head": "target_mode",
          "applicable_when": "他人或受众是话语对象"
        },
        "CLAIM_OR_NARRATIVE": {
          "name_zh": "主张或叙事",
          "definition": "焦点是传闻、小作文、争论或论坛叙事",
          "select_when": "文本讨论某个说法、故事或争论",
          "not_select_when": "只有资产事实或作者动作",
          "confusable_with": ["OTHER_PERSON_OR_AUDIENCE"],
          "examples": ["小作文到底是谁写的"],
          "logical_owner_head": "target_mode",
          "applicable_when": "主张/叙事本身是焦点"
        },
        "MARKET_OR_INDUSTRY": {
          "name_zh": "市场或行业",
          "definition": "焦点是市场、行业或产品环境",
          "select_when": "文本主要讨论行业、市场或政策环境",
          "not_select_when": "只讨论单一资产或作者行为",
          "confusable_with": ["ASSET_OR_COMPANY"],
          "examples": ["光伏行业产能"],
          "logical_owner_head": "target_mode",
          "applicable_when": "市场/行业环境是焦点"
        },
        "UNKNOWN": {
          "name_zh": "无法判断",
          "definition": "存在话语焦点问题但无法确定",
          "select_when": "有焦点线索但对象不可辨",
          "not_select_when": "因子缺失或不适用",
          "confusable_with": ["缺失"],
          "examples": ["这是什么意思"],
          "logical_owner_head": "target_mode",
          "applicable_when": "焦点问题存在但证据不足"
        }
      },
      "missing_semantics": "unannotated_or_not_applicable",
      "unknown_semantics": "factor_present_but_not_determinable",
      "missing_loss_mask": 0,
      "unknown_loss_mask": 1,
      "unknown_is_exclusive": true
    }
  },
  "record_contract": {
    "auxiliary_field": "auxiliary_factors",
    "missing_factor": "omit the factor key; value=null is not a missing marker",
    "missing_loss_mask": 0,
    "unknown_is_explicit": true,
    "unknown_loss_mask": 1,
    "do_not_backfill_from_human100": true
  },
  "record_types": {
    "v021_full_seven_head_label": {
      "schema_version": "semantic-schema-calibrated-v0.2.1",
      "required_heads": ["target_mode", "stance", "emotion_primary", "emotion_target", "action_tendency", "reasoning_tags", "context_dependency"],
      "forbid_fields": ["auxiliary_factors"]
    },
    "v03_sparse_auxiliary_assignment": {
      "schema_version": "semantic-schema-candidate-v0.3",
      "required_fields": ["sample_id", "head", "answer", "is_final", "schema_version"],
      "head_values": ["expectation_phase", "arousal_level", "desired_price_direction", "market_scope", "discourse_focus"],
      "legacy_heads_forbidden": true,
      "unfinished_assignment_loss_mask": 0
    }
  },
  "action_hierarchy": {
    "parent_class_order": ["INCREASE_EXPOSURE", "MAINTAIN_EXPOSURE", "ACTIVE_REBALANCE", "DECREASE_EXPOSURE", "NO_EXECUTION", "UNKNOWN"],
    "children": {
      "INCREASE_EXPOSURE": ["BUY", "ADD"],
      "MAINTAIN_EXPOSURE": ["HOLD"],
      "ACTIVE_REBALANCE": ["DO_T"],
      "DECREASE_EXPOSURE": ["REDUCE", "SELL"],
      "NO_EXECUTION": ["WATCH", "NO_ACTION_SIGNAL"],
      "UNKNOWN": ["UNKNOWN"]
    },
    "probability_rule": "parent probability is the sum of its child probabilities",
    "metric_rule": "map both truth and prediction through the same child-to-parent mapping before parent metrics"
  },
  "migration_rules": {
    "retain_v021_heads": true,
    "auxiliary_missing_uses_loss_mask_zero": true,
    "unknown_is_not_missing": true,
    "strict_and_parent_metrics_both_required": true,
    "new_factor_outputs_require_new_initialization": true
  }
}
